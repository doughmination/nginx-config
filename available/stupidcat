server {
    listen 80;
    listen [::]:80;

    server_name www.stupid.cat stupid.cat;

    return 301 https://stupid.cat$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name www.stupid.cat;

    ssl_certificate     /etc/letsencrypt/live/stupid.cat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stupid.cat/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://stupid.cat$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name stupid.cat;

    ssl_certificate     /etc/letsencrypt/live/stupid.cat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stupid.cat/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    root /srv/ari/stupid.cat;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }
}
