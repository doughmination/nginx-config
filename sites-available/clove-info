map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---- HTTP → HTTPS (canonical host) ----
server {
    listen 80;
    listen [::]:80;

    server_name www.doughmination.info;

    return 301 https://doughmination.info$request_uri;
}

# ---- clove.stupid.cat (HTTPS) → canonical c.stupid.cat ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name www.doughmination.info;

    ssl_certificate     /etc/letsencrypt/live/doughmination.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination.info/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://doughmination.info$request_uri;
}

# ---- c.stupid.cat (HTTPS) → Next.js app (Docker) on 127.0.0.1:5002 ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name doughmination.info;

    ssl_certificate     /etc/letsencrypt/live/doughmination.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination.info/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:4050;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 60s;
    }
}
