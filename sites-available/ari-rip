server {
    listen 80;
    listen [::]:80;

    server_name ari.rip www.ari.rip;
    return 301 https://ari.rip$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name www.ari.rip;
    ssl_certificate     /etc/letsencrypt/live/ari.rip/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ari.rip/privkey.pem; # managed by Certbot
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://ari.rip$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name ari.rip;
    ssl_certificate     /etc/letsencrypt/live/ari.rip/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ari.rip/privkey.pem; # managed by Certbot
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    root /srv/ari/ari.rip;
    index index.html;

    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /404.html {
        internal;
    }

}
