server {
    listen 80;
    listen [::]:80;
    server_name status.gaybot.site;

    # Certbot ACME challenge (kept in case the cert is ever expanded)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name status.gaybot.site;

    # Reuse the main gaybot.site certificate
    ssl_certificate     /etc/letsencrypt/live/gaybot.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gaybot.site/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/status.gaybot.site.access.log;
    error_log  /var/log/nginx/status.gaybot.site.error.log;

    # Proxy to the bot's status server (serves the dashboard at / and the
    # /api/status, /api/stats endpoints).
    location / {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
