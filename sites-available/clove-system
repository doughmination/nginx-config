# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name www.doughmination.co.uk doughmination.co.uk;
    return 301 https://doughmination.co.uk$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.doughmination.co.uk;
    ssl_certificate /etc/letsencrypt/live/doughmination.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination.co.uk/privkey.pem;
    return 301 https://doughmination.co.uk$request_uri;
}

# Main site (HTTPS)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name doughmination.co.uk;

    ssl_certificate /etc/letsencrypt/live/doughmination.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination.co.uk/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include snippets/cf-real-ip.conf;
    include snippets/headers.conf;

    # Nginx status (localhost only)
    location /nginx_status {
        stub_status on;
        access_log off;
        allow 127.0.0.1;
        deny all;
    }

    # Login endpoint with strict rate limiting
    location /api/login {
        limit_req zone=login_limit burst=3 nodelay;
        
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # /api/ with rate limiting
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 86400;
    }

    # WebSocket handler with optimized settings
    location /ws {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_connect_timeout 60;
        
        # WebSocket specific
        proxy_buffering off;
        proxy_cache off;
    }

    # Shortened API routes (rewritten to /api/…)
    location ~ ^/(members|fronters|system|subsystems|cofronts|is_admin|users|metrics) {
        limit_req zone=api_limit burst=20 nodelay;
        
        proxy_pass http://localhost:5000/api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # Serve /avatars/ static content via backend
    location /avatars/ {
        client_max_body_size 5M;
        
        proxy_pass http://localhost:5000/avatars/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        add_header Cache-Control "public, max-age=3600";
    }

    # Internal location for bot requests
    location /bot {
        internal;
        rewrite ^/bot(.*)$ $1 break;
        
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    # Catch-all with bot detection
    location / {
        # Default to frontend
        set $backend "frontend";
        
        # Detect bots/crawlers and route to backend
        if ($http_user_agent ~* "bot|crawl|slurp|spider|mediapartners|facebookexternalhit|twitterbot|whatsapp|telegram|discord|slack|linkedin") {
            set $backend "backend";
        }
        
        # Route to backend for bots (meta tag injection)
        if ($backend = "backend") {
            rewrite ^(.*)$ /bot$1 last;
        }
        
        # Regular browsers get the frontend SPA
        proxy_pass http://localhost:5001/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
    }
}
