server {
    listen 80;
    listen [::]:80;
    server_name fonts.doughmination.co.uk;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name fonts.doughmination.co.uk;

    ssl_certificate     /etc/letsencrypt/live/doughmination.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination.co.uk/privkey.pem;

    root /srv/web/web/fonts;
    index index.html;

    # Serve fonts with CORS + caching
    location ~* \.(woff2?|ttf|otf|eot)$ {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        types {
            font/woff2 woff2;
            font/woff  woff;
        }
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
