server {
    listen 80;
    listen [::]:80;
    server_name www.doughmination.tech doughmination.tech;

    return 301 https://doughmination.tech$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.doughmination.tech;

    ssl_certificate /etc/letsencrypt/live/doughmination.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination.tech/privkey.pem;

    return 301 https://doughmination.tech$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name doughmination.tech;

    ssl_certificate /etc/letsencrypt/live/doughmination.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination.tech/privkey.pem;

    include snippets/cf-real-ip.conf;

    location / {
        proxy_pass http://127.0.0.1:4040;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Needed for WebSockets (if your app uses them)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
