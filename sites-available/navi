# /etc/nginx/sites-available/navi
# doughmination.me -> music service (127.0.0.1:4060)

# www -> apex redirect (http)
server {
    listen 80;
    server_name www.doughmination.me doughmination.me;
    return 301 https://doughmination.me$request_uri;
}

# www -> apex redirect (https)
server {
    listen 443 ssl;
    server_name www.doughmination.me;

    ssl_certificate     /etc/letsencrypt/live/doughmination/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination/privkey.pem;

    return 301 https://doughmination.me$request_uri;
}

# apex -> music
server {
    listen 443 ssl;
    server_name doughmination.me;

    ssl_certificate     /etc/letsencrypt/live/doughmination/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination/privkey.pem;

    # Allow large audio uploads (the 413 fix). Raise if you upload bigger
    # files; keep it >= MUSIC_MAX_UPLOAD_MB (default 200M).
    client_max_body_size 500M;

    location / {
        proxy_pass http://127.0.0.1:4060;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Stream uploads straight to the app instead of buffering to disk first.
        proxy_request_buffering off;

        # Don't cut off long uploads / long-held audio streams.
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
    }
}
