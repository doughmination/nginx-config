server {
    listen 80;
    listen [::]:80;
    server_name doughmination.systems www.doughmination.systems;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name doughmination.systems www.doughmination.systems;

    ssl_certificate     /etc/letsencrypt/live/doughmination/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:4181;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;         # Dozzle streams logs over websocket
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
