map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---- OLD HOSTS (HTTP) → NEW DOMAIN ----
server {
    listen 80;
    listen [::]:80;

    server_name c.stupid.cat clove.stupid.cat;

    return 301 https://doughmination.gay$request_uri;
}

# ---- OLD HOSTS (HTTPS) → NEW DOMAIN ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name c.stupid.cat clove.stupid.cat;

    ssl_certificate     /etc/letsencrypt/live/stupid.cat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stupid.cat/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://doughmination.gay$request_uri;
}

# ---- NEW DOMAIN (HTTP) → HTTPS ----
server {
    listen 80;
    listen [::]:80;

    server_name doughmination.gay www.doughmination.gay;

    return 301 https://doughmination.gay$request_uri;
}

# ---- www → apex ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name www.doughmination.gay;

    ssl_certificate     /etc/letsencrypt/live/doughmination/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://doughmination.gay$request_uri;
}

# ---- doughmination.gay → Next.js app ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name doughmination.gay;

    ssl_certificate     /etc/letsencrypt/live/doughmination/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doughmination/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10m;

    # Compression
    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_types        text/plain text/css application/javascript text/javascript
                      application/json image/svg+xml application/xml application/rss+xml;

    location / {
        proxy_pass http://127.0.0.1:5002;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 60s;
    }
}
